ELM_BIND_ADDR=0.0.0.0:8080
ELM_DB_MAX_CONNECTIONS=10
ELM_SESSION_TTL_HOURS=12
DATABASE_URL=postgres://ertip_lead_manager:change-me@postgres:5432/ertip_lead_manager
RUST_LOG=info,ertip_lead_manager_server=debug,tower_http=info

# Configure these only for the first empty-database deployment.
# After the first ADMIN is created successfully, remove the bootstrap password secret.
ELM_BOOTSTRAP_ADMIN_NAME=Ertip Admin
ELM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ELM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
